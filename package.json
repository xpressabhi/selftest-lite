{
	"name": "selftest-lite",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/check-build-mode.mjs",
		"preview": "vite preview",
		"start": "vite preview",
		"lint": "eslint .",
		"smoke": "npm run lint && npm run test && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:push": "playwright test --config=playwright.push.config.js",
		"hooks:install": "git config core.hooksPath .githooks && echo hooks installed",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "svelte-kit sync && vite build && node scripts/check-build-mode.mjs",
		"test": "vitest run",
		"locales:unused": "node scripts/check-unused-locale-keys.mjs",
		"telemetry:report": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/telemetry-report.mjs",
		"telemetry:backfill": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-test-metadata.mjs",
		"telemetry:backfill-visits": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-test-visits.mjs",
		"telemetry:archive": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/archive-telemetry.mjs",
		"reminders:send": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/send-reminders.mjs",
		"eval:content": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval-content.mjs",
		"exams:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-exam-notifications.mjs",
		"exams:discover": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-exam-notifications.mjs --discover",
		"cap:sync": "cap sync android",
		"cap:open": "cap open android",
		"apk:debug": "cd android && JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.12/libexec/openjdk.jdk/Contents/Home ./gradlew :app:assembleDebug",
		"apk:release": "cd android && JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.12/libexec/openjdk.jdk/Contents/Home ./gradlew :app:assembleRelease",
		"assets:android": "node scripts/generate-android-assets.mjs",
		"verify:vercel": "npm run build && node scripts/verify-vercel.mjs"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/keyboard": "^8.0.5",
		"@capgo/capacitor-keep-awake": "^8.1.15",
		"@chenglou/pretext": "^0.0.8",
		"@google/genai": "^2.16.0",
		"@neondatabase/serverless": "^1.1.0",
		"@typesafe-ai/sdk": "^0.6.0",
		"@vercel/analytics": "^2.0.1",
		"katex": "^0.18.4",
		"mermaid": "^11.16.1",
		"rehype-katex": "^7.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"web-push": "^3.6.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/cli": "^8.5.0",
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@tailwindcss/postcss": "^4.3.3",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"postcss": "^8.5.26",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "22.x"
	}
}
