{
	"name": "selftest-lite",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/check-build-mode.mjs",
		"preview": "vite preview",
		"start": "vite preview",
		"lint": "eslint .",
		"smoke": "npm run lint && npm run test && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:push": "playwright test --config=playwright.push.config.js",
		"hooks:install": "git config core.hooksPath .githooks && echo hooks installed",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "svelte-kit sync && vite build && node scripts/check-build-mode.mjs",
		"test": "vitest run",
		"locales:unused": "node scripts/check-unused-locale-keys.mjs",
		"telemetry:report": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/telemetry-report.mjs",
		"telemetry:backfill": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-test-metadata.mjs",
		"telemetry:backfill-visits": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-test-visits.mjs",
		"telemetry:archive": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/archive-telemetry.mjs",
		"attempts:backfill-links": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backfill-attempt-links.mjs",
		"reminders:send": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/send-reminders.mjs",
		"eval:content": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval-content.mjs",
		"exams:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-exam-notifications.mjs",
		"exams:discover": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-exam-notifications.mjs --discover",
		"exams:patterns": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/warm-exam-patterns.mjs",
		"verify:vercel": "npm run build && node scripts/verify-vercel.mjs"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.9",
		"@google/genai": "^2.28.0",
		"@neondatabase/serverless": "^1.2.0",
		"@simplewebauthn/server": "^14.0.3",
		"@typesafe-ai/sdk": "^0.6.0",
		"@vercel/analytics": "^2.0.1",
		"katex": "^0.19.0",
		"mermaid": "^12.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.9",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postcss": "^8.5.30",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.4"
	},
	"engines": {
		"node": "22.x"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "^3.0.1"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
