# Environment variables template - copy to .env.local and fill in values.

# AI generation (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (required)
DATABASE_URL=postgres://username:password@host:5432/database

# Web push (optional, daily reminders). Generate keys with:
#   npx web-push generate-vapid-keys
# PUBLIC_VAPID_KEY is exposed to the browser; add it to Vercel as Plaintext
# (PUBLIC_-prefixed vars cannot be marked Sensitive). VAPID_PRIVATE_KEY stays
# private and is only needed as a GitHub Actions secret for the sender.
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Admin access (protects /api/admin/* and /admin dashboard)
# Optional: only needed if you want to use the admin dashboard.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
# Optional: stable secret for admin session cookies. If unset, sessions are
# derived from the admin credentials (rotating the password logs everyone out).
ADMIN_SESSION_SECRET=

# Google Sign-In (optional)
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console. Browser sign-in (popup mode) only needs these Authorized
# JavaScript origins: `http://localhost:5173` and `https://www.selftest.in`.
# The Android app uses the redirect flow, which posts the id_token to the
# `/auth/redirect` server endpoint — register `https://www.selftest.in/auth/redirect`
# (and `http://localhost:5173/auth/redirect` when testing the app against a
# local dev server) under Authorized redirect URIs (web server flow).
# The consent screen must link a privacy policy URL
# (https://www.selftest.in/privacy).
# If the env var is missing, the built-in client id from
# src/lib/shared/googleAuth.js is used as a fallback.
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
